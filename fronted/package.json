{
  "name": "vtuber-live-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:live",
    "dev:live": "vite --mode live --port 5173",
    "dev:console": "vite --mode console --port 5174",
    "build": "npm run build:live && npm run build:console",
    "build:live": "vue-tsc --noEmit && vite build --mode live",
    "build:console": "vite build --mode console",
    "preview:live": "vite preview --mode live --port 4173",
    "preview:console": "vite preview --mode console --port 4174"
  },
  "dependencies": {
    "hls.js": "^1.6.15",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@vitejs/plugin-vue": "^5.0.4",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^6.4.3",
    "vue-tsc": "^2.0.6"
  }
}
